rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function userExists() {
      return exists(userDocPath());
    }

    function userData() {
      return userDocPath().data;
    }

    function isActiveUser() {
      return isSignedIn() && userExists() && userData().get('activo', true) != false;
    }

    function roleText() {
      let d = userData();
      return (d.get('puesto', '') + ' ' + d.get('role', '')).lower();
    }

    function isUserManager() {
      return isActiveUser() && (
        roleText().matches('.*(admin|gerente|manager|calidad|quality|administrativo).*')
      );
    }

    // Perfil propio: no puede darse de alta solo ni cambiar activo/puesto/correo.
    function selfProfileSafeKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'nombre', 'phone', 'telefono', 'photoUrl', 'photoURL', 'updatedAt']);
    }

    function canReadPatronesCalibracion() {
      return isActiveUser() && roleText().matches(
        '.*(calidad|quality|admin|gerente|manager|metrologo|metr[oó]logo|tecnico|t[eé]cnico|logistica|ventas).*'
      );
    }

    function canWritePatronesCalibracion() {
      return isActiveUser() && roleText().matches(
        '.*(calidad|quality|admin|gerente|manager|metrologo|metr[oó]logo|tecnico|t[eé]cnico).*'
      );
    }

    // Metadatos de patrones (incl. certificadoStoragePath; sin URLs públicas nuevas)
    match /patronesCalibracion/{patronId} {
      allow read: if canReadPatronesCalibracion();
      allow create, update: if canWritePatronesCalibracion();
      allow delete: if isActiveUser() && roleText().matches('.*(admin|gerente|manager).*');
    }

    // Auditoría de acceso a certificados (solo escritura vía Functions Admin SDK)
    match /certificadoAccesos/{entryId} {
      allow read: if isActiveUser() && roleText().matches('.*(calidad|quality|admin|gerente|manager).*');
      allow write: if false;
    }

    function canManageAppNovedades() {
      return isActiveUser() && roleText().matches('.*(calidad|administrativo).*');
    }

    match /appNovedades/{novedadId} {
      allow read: if isActiveUser();
      allow create: if canManageAppNovedades();
      allow update, delete: if canManageAppNovedades();
    }

    // Formatos Master — metadatos del repositorio controlado
    function canReadFormatosMaster() {
      return isActiveUser() && roleText().matches(
        '.*(calidad|quality|admin|gerente|manager|metrologo|metr[oó]logo|tecnico|t[eé]cnico).*'
      );
    }

    function canWriteFormatosMaster() {
      return isActiveUser() && roleText().matches(
        '.*(calidad|quality|admin|gerente|manager).*'
      );
    }

    match /formatos_master/{formatoId} {
      allow read: if canReadFormatosMaster();
      allow create, update, delete: if canWriteFormatosMaster();
    }

    // Usuarios: alta Auth solo por Cloud Functions. Activar/desactivar: managers.
    match /usuarios/{userId} {
      allow read: if isSignedIn();
      allow create, delete: if false;
      allow update: if isActiveUser() && (
        (request.auth.uid == userId && selfProfileSafeKeys()) ||
        isUserManager()
      );
    }

    // Resto de colecciones: requiere usuario activo autorizado en `usuarios/{uid}`
    match /{collection}/{document=**} {
      allow read, write: if collection != 'usuarios' && isActiveUser();
    }
  }
}
